# Public access key from web3forms.com (created with dr.varadharajan@gmail.com).
# Without it the appointment form shows a call/WhatsApp fallback instead of submitting.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Canonical site URL. Defaults to https://drvaradharajan.com when unset.
NEXT_PUBLIC_SITE_URL=

# Set to "true" only on the production deployment once the domain cutover is done.
# Any other value makes robots.txt disallow all crawling and pages emit noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false
